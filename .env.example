# คัดลอกไฟล์นี้เป็น .env.local ตอนพัฒนา หรือไปตั้งค่าใน Environment Variables ของ Vercel

# --- ฐานข้อมูล PostgreSQL (Neon Serverless บน Vercel) ---
# แนะนำ: เมื่อเชื่อมต่อ Neon ใน Vercel ระบบจะสร้าง DATABASE_URL / POSTGRES_URL ให้อัตโนมัติ
# หรือสร้าง Database ที่ https://neon.tech แล้วนำ Connection String มาวางที่นี่
DATABASE_URL=postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
# (หรือใช้ POSTGRES_URL ที่ Vercel สร้างให้)
POSTGRES_URL=

# --- บัญชีแม่ค้า (จำเป็นบน production) ---
MERCHANT_USERNAME=admin
MERCHANT_PASSWORD=1234

# --- คีย์ลงลายเซ็น session (จำเป็นบน production) สุ่มสตริงยาวๆ เช่น openssl rand -base64 32 ---
SESSION_SECRET=thai-kitchen-secret-key-production-neon-pos
